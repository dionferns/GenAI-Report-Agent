FROM python:3.11-slim

WORKDIR /var/task

# Install dependencies — use lambda-specific requirements with pinned numpy
# All packages have pre-built wheels, no compilation needed
COPY requirements-lambda.txt .
RUN pip install --no-cache-dir -r requirements-lambda.txt && rm requirements-lambda.txt

# Copy source code into /var/task/reportagent/
COPY src/reportagent/ /var/task/reportagent/

# Lambda handler entrypoint
# Format: /path/to/handler/file.handler_function
# This tells Lambda: look in /var/task for reportagent.lambda_handler module, call lambda_handler function
CMD ["reportagent.lambda_handler.lambda_handler"]
